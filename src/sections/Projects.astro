---
import {
  ArrowUpRight,
  ArrowRight,
  ArrowLeft,
  Image as ImageIcon,
} from '@lucide/astro';
// SECTION: Project entries, screenshots, and live links
const projects = [
  {
    number: '01',
    eyebrow: 'Healthcare Knowledge Platform',
    title: 'NironCare Knowledge Center',
    shortName: 'NironCare',
    type: 'ADITI · UX/UI Design & Business Analysis',
    period: 'August 2026 - Present',
    url: 'https://knowledge-center.nironcare.com/',
    displayUrl: 'knowledge-center.nironcare.com',
    screenshot: '/images/nironcare-knowledge-center-screenshot.png',
    screenshotAlt: 'NironCare Knowledge Center interface preview',
    previewLabel: 'Live Platform',
    status: 'Live',
    overview:
      'A healthcare knowledge center that organizes product documentation, role-based guidance, developer resources, and support content into a clearer browsing experience.',
    contribution: [
      'Helped translate requirements into content structure, user flows, wireframes, and interface designs. Focused on helping visitors find relevant information through clear navigation and readable layouts.',
    ],
    tags: ['UX/UI Design', 'Information Architecture', 'User Flows', 'Figma'],
  },
  {
    number: '02',
    eyebrow: 'Housing Services Platform',
    title: 'SuperAslan',
    shortName: 'SuperAslan',
    type: 'ADITI · UX/UI Design & Business Analysis',
    period: 'June 2026 - July 2026',
    url: null,
    displayUrl: 'Image Case Study',
    screenshot: '/images/superaslan-screenshot.png',
    screenshotAlt: 'SuperAslan housing services platform preview',
    previewLabel: 'Design Preview',
    status: 'Case Study',
    overview:
      'A housing services platform designed to help users explore services and request bookings or quotations.',
    contribution: [
      'Helped structure service discovery, booking, and quotation flows. Created interface designs that make the available options and next steps easier to understand.',
    ],
    tags: ['UX/UI Design', 'Service Flows', 'Wireframes', 'Figma'],
  },
  {
    number: '03',
    eyebrow: 'E-Commerce Platform',
    title: 'Phsar Korea',
    shortName: 'Phsar Korea',
    type: 'ADITI · UX/UI Design & Business Analysis',
    period: 'April 2026 - June 2026',
    url: 'https://web.dev.phsar-korea.d.aditidemo.asia/',
    displayUrl: 'web.dev.phsar-korea.d.aditidemo.asia',
    screenshot: '/images/phsar-korea-screenshot.png',
    screenshotAlt: 'Phsar Korea commerce platform preview',
    previewLabel: 'Test Preview',
    status: 'Preview',
    ctaLabel: 'View Test Preview ->',
    overview:
      'A commerce platform connecting shoppers with products available across Cambodia and Korea.',
    contribution: [
      'Worked on interface flows for product discovery, checkout, orders, and refunds. Used requirements and stakeholder feedback to shape practical, consistent screens for the shopping journey.',
    ],
    tags: ['UX/UI Design', 'E-Commerce', 'User Flows', 'Figma'],
  },
  {
    number: '04',
    eyebrow: 'Government Digital Platform',
    title: 'Digital Skills Development Program',
    shortName: 'DSDP',
    type: 'Digital Skills Development Program',
    period: 'August 2025 - November 2025',
    url: 'https://dsdp.gov.kh/en/',
    displayUrl: 'dsdp.gov.kh',
    logo: '/logos/dsdp-logo.png',
    logoAlt: 'DSDP Logo',
    screenshot: '/images/DSDP screenshot.png',
    screenshotAlt: 'DSDP homepage screenshot',
    overview:
      "The Digital Skills Development Program (DSDP) is a national initiative focused on strengthening digital literacy and supporting Cambodia's digital transformation efforts.",
    contribution: [
      "As part of the frontend team, I contributed to building structured, responsive interfaces aligned with the government's design system. I implemented reusable UI components, integrated backend-managed content into dynamic layouts, and ensured consistency across multiple screen sizes.",
      'The work focused on long-term maintainability, scalability, and clean frontend architecture within a government production environment.',
    ],
    tags: [
      'Frontend Development',
      'Responsive UI',
      'Reusable Components',
      'Content Integration',
    ],
  },
  {
    number: '05',
    eyebrow: 'Government Digital Workspace',
    title: 'Chaktomuk Digital Workspace',
    shortName: 'Chaktomuk',
    type: 'Digital Workspace',
    period: 'July 2025 - March 2026',
    url: 'https://chaktomuk.gov.kh/en',
    displayUrl: 'chaktomuk.gov.kh',
    logo: '/logos/ctm-logo.png',
    logoAlt: 'Chaktomuk Logo',
    screenshot: '/images/Chaktomuk screenshot.png',
    screenshotAlt: 'Chaktomuk Digital Workspace screenshot',
    overview:
      'Chaktomuk Digital Workspace is an internal government platform designed to support structured digital workflows and cross-ministry coordination.',
    contribution: [
      'Contributed to quality assurance processes by testing interface flows and validating system behavior before deployment.',
      'I also assisted in reviewing and correcting Khmer-language translations to ensure linguistic accuracy, clarity, and consistency across internal modules.',
    ],
    tags: [
      'Quality Assurance',
      'Interface Testing',
      'Workflow Validation',
      'Khmer Language',
    ],
  },
  {
    number: '06',
    eyebrow: 'Government Event Platform',
    title: 'EventKH',
    shortName: 'EventKH',
    type: 'EventKH',
    period: 'January 2025 - January 2026',
    url: 'https://event.gov.kh/en',
    displayUrl: 'eventkh.gov.kh',
    logo: '/logos/eventkh-logo.png',
    logoAlt: 'EventKH Logo',
    screenshot: '/images/EventKH screenshot.png',
    screenshotAlt: 'EventKH platform screenshot',
    overview:
      'EventKH is a government-operated event platform that enables authorized ministry officials to publish official events while allowing the public to browse and register online.',
    contribution: [
      'I contributed to implementing structured frontend layouts for event listings, detail pages, and registration flows.',
      'The work involved building modular UI components using Astro and Tailwind CSS, integrating dynamic event data from backend systems, and ensuring responsive behavior across devices. The emphasis was on clarity, consistency, and adherence to government design standards within a production-scale system.',
    ],
    tags: ['Astro', 'Tailwind CSS', 'Responsive UI', 'Backend Integration'],
  },
  {
    number: '07',
    eyebrow: 'Government Design System',
    title: 'Rachana Government Design System',
    shortName: 'Rachana',
    type: 'MPTC · UX/UI Design',
    period: 'May 2024 - February 2025',
    url: 'https://rachana.gov.kh/en/',
    displayUrl: 'rachana.gov.kh',
    screenshot: '/images/rachana-screenshot.png',
    screenshotAlt: 'Rachana Government Design System homepage screenshot',
    overview:
      'A design system supporting consistent interfaces across Cambodian government digital platforms.',
    contribution: [
      'Created and refined reusable Figma components, supported responsive layouts and accessibility improvements, and contributed to interface guidelines for a consistent government digital identity.',
    ],
    tags: ['Figma', 'Design System', 'Responsive Design', 'Accessibility'],
  },
];
---

<section
  id="projects"
  data-nav-target="projects"
  class="projects-section section-pad"
  aria-labelledby="projects-title"
>
  <header class="section-heading-row" data-reveal>
    <div>
      <h2
        id="projects-title"
        class="display-heading"
        data-heading-effect="decrypt"
      >
        BUILT FOR THE <em>REAL WORLD.</em>
      </h2><p class="section-description">
        Government platforms. Everyday services. Thoughtful interfaces.<br />A
        selection of things I've helped bring to life.
      </p>
    </div>
  </header>
  {/* SECTION: Project selector and previous/next buttons */}
  <div class="project-browser">
    <div class="project-selector" aria-label="Choose a project">
      {
        projects.map((project, index) => (
          <button
            type="button"
            data-project-select={index}
            aria-pressed={index === 0}
            class:list={{ selected: index === 0 }}
          >
            {project.shortName}
          </button>
        ))
      }
    </div>
    <div class="gallery-navigation">
      <button
        class="icon-button gallery-prev"
        type="button"
        aria-label="Previous project"
        title="Previous project"
        disabled><ArrowLeft size={22} /></button
      >
      <button
        class="icon-button gallery-next"
        type="button"
        aria-label="Next project"
        title="Next project"><ArrowRight size={22} /></button
      >
    </div>
  </div>
  {/* SECTION: Project slide content and screenshot preview */}
  <div class="project-gallery">
    <div
      class="project-rail"
      tabindex="0"
      role="region"
      aria-label="Project showcase"
    >
      {
        projects.map((project) => (
          <article
            class="project-slide"
            aria-labelledby={`project-${project.number}`}
          >
            <div class="project-copy">
              <p class="project-eyebrow mono">
                <span>{project.number}</span> / {project.eyebrow}
              </p>
              <h3 id={`project-${project.number}`}>{project.title}</h3>
              <>
                <p class="project-role mono">{project.type}</p>
                <p class="project-period mono">{project.period}</p>
              </>
              <div class="project-overview">
                <>
                  <h4 class="mono">OVERVIEW</h4>
                  <p>{project.overview}</p>
                </>
              </div>
              <details class="project-contribution" open>
                <>
                  <summary class="mono">MY CONTRIBUTION</summary>
                  <div>
                    {project.contribution.map((paragraph) => (
                      <p>{paragraph}</p>
                    ))}
                  </div>
                </>
              </details>
              <ul class="project-tags mono" aria-label="Project skills">
                {project.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
              <a
                href={project.url ?? project.screenshot}
                target="_blank"
                rel="noopener noreferrer"
                class="text-link project-link"
              >
                {project.url
                  ? project.status === 'Preview'
                    ? 'OPEN TEST PREVIEW'
                    : 'VISIT PROJECT'
                  : 'VIEW DESIGN'}
                {project.url ? (
                  <ArrowUpRight size={18} />
                ) : (
                  <ImageIcon size={18} />
                )}
              </a>
            </div>
            <div class="project-visual">
              <div class="project-window-bar mono">
                <>
                  <span>
                    <i class="status-dot" />
                    {project.previewLabel ?? 'LIVE PLATFORM'}
                  </span>
                  <span>
                    {project.url ? project.displayUrl : 'DESIGN SHOWCASE'}
                  </span>
                </>
              </div>
              <a
                href={project.url ?? project.screenshot}
                target="_blank"
                rel="noopener noreferrer"
                class="project-image-link"
                aria-label={`Open ${project.title}`}
              >
                <img
                  src={project.screenshot}
                  alt={project.screenshotAlt}
                  width="1920"
                  height="1080"
                  loading="lazy"
                  decoding="async"
                />
              </a>
            </div>
          </article>
        ))
      }
    </div>
    <p class="sr-only" data-gallery-status role="status"></p>
  </div>
</section>
<script>
  import { initProjectGallery } from '../scripts/project-gallery';
  initProjectGallery();
</script>
