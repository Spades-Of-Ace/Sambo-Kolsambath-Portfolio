<section class="projects-page" aria-labelledby="projects-title">
  <div class="projects-grid-overlay" aria-hidden="true"></div>

  <header class="projects-hero">
    <div>
      <h1 id="projects-title" class="projects-heading">
        <span>Things I've</span>
        <span>Helped</span>
        <span class="outline">Build.</span>
      </h1>
      <p class="projects-intro">
        A selection of digital platforms I've contributed to across frontend
        development, quality assurance, UX/UI design, and business analysis.
      </p>
    </div>
  </header>

  <div class="project-stack">
    {
      projects.map((project, index) => (
        <article
          class:list={['project-row', { 'is-reversed': index % 2 === 1 }]}
        >
          <div class="project-copy">
            <span class="project-index" aria-hidden="true">
              {project.number}
            </span>
            <p class="project-eyebrow">
              {project.number} / {project.eyebrow}
            </p>
            <h2>{project.title}</h2>
            <p class="project-type">{project.type}</p>
            <p class="project-period">{project.period}</p>

            <div class="project-section">
              <h3>Overview</h3>
              <p>{project.overview}</p>
            </div>

            <div class="project-section">
              <h3>Contribution</h3>
              {project.contribution.map((paragraph) => <p>{paragraph}</p>)}
            </div>

            <ul class="project-tags" aria-label={`${project.title} tags`}>
              {project.tags.map((tag) => <li>{tag}</li>)}
            </ul>

            {
              project.url ? (
                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="project-cta"
                >
                  {project.ctaLabel ?? 'View Live Project ->'}
                </a>
              ) : (
                <p class="project-cta project-cta-static">Image Case Study</p>
              )
            }
          </div>

          <a
            href={project.url ?? undefined}
            target={project.url ? '_blank' : undefined}
            rel={project.url ? 'noopener noreferrer' : undefined}
            class:list={['project-frame', { 'is-static': !project.url }]}
            aria-label={project.url ? `View ${project.title}` : undefined}
          >
            <div class="frame-topline">
              <span><i></i> {project.previewLabel ?? 'Live Platform'}</span>
              <span>{project.displayUrl}{project.url ? ' ->' : ''}</span>
            </div>

            <div class="project-preview">
              <div class="preview-browser">
                <span></span>
                <span></span>
                <span></span>
              </div>
              {
                project.screenshot ? (
                  <img
                    src={project.screenshot}
                    alt={project.screenshotAlt}
                    class="project-screenshot"
                    loading="lazy"
                  />
                ) : (
                  <div class="project-image-placeholder" role="img" aria-label={project.screenshotAlt}>
                    <span>{project.shortName}</span>
                    <small>Project image coming soon</small>
                  </div>
                )
              }
            </div>

            <div class="frame-footer">
              <span>Project / {project.number}</span>
              <span>Status / <strong>{project.status ?? 'Live'}</strong></span>
            </div>
          </a>
        </article>
      ))
    }
  </div>
</section>
