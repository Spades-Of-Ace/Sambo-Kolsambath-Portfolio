---
import {
  ArrowUpRight,
  Download,
  FileText,
  Mail,
  BriefcaseBusiness,
  Send,
  MessagesSquare,
} from '@lucide/astro';
type ContactLink = {
  label: string;
  href: string;
  icon: string | typeof FileText;
  download?: boolean;
};
const contactGroups: {
  title: string;
  icon: typeof FileText;
  links: ContactLink[];
}[] = [
  {
    title: 'Professional',
    icon: BriefcaseBusiness,
    links: [
      {
        label: 'LinkedIn',
        href: 'https://www.linkedin.com/in/sambo-kolsambath-76269a2a0/',
        icon: '/svg%20icon/linkedin-logo-bold.svg',
      },
      {
        label: 'GitHub',
        href: 'https://github.com/Spades-Of-Ace',
        icon: '/svg%20icon/github-logo-bold.svg',
      },
      {
        label: 'Download Resume',
        href: '/cv/Resume.pdf',
        icon: FileText,
        download: true,
      },
      {
        label: 'Download CV',
        href: '/cv/Curriculum Vitae.pdf',
        icon: FileText,
        download: true,
      },
    ],
  },
  {
    title: 'Direct',
    icon: Send,
    links: [
      {
        label: 'Email',
        href: 'https://mail.google.com/mail/?view=cm&fs=1&to=kolsambathsambo@gmail.com',
        icon: Mail,
      },
      {
        label: 'Telegram',
        href: 'https://t.me/Spades_Of_Ace',
        icon: '/svg%20icon/telegram-logo-bold.svg',
      },
    ],
  },
  {
    title: 'Social',
    icon: MessagesSquare,
    links: [
      {
        label: 'Facebook',
        href: 'https://www.facebook.com/Spade.0f.ace/',
        icon: '/svg%20icon/facebook-logo-bold.svg',
      },
    ],
  },
];
---

<section
  id="contact"
  data-nav-target="contact"
  class="contact-section section-pad"
  aria-labelledby="contact-title"
>
  <div class="contact-intro" data-reveal>
    <p class="small-label mono">
      <i class="status-dot"></i> OPEN TO OPPORTUNITIES & COLLABORATIONS
    </p><h2 id="contact-title">
      LET'S BUILD<br /><a href="mailto:kolsambathsambo@gmail.com"
        ><span data-heading-effect="shine">WHAT'S NEXT.</span><ArrowUpRight
          aria-hidden="true"
        /></a
      >
    </h2><p>
      Have a project in mind, a role to talk about, or an idea worth exploring?<br
      />I'd love to hear from you.
    </p><a href="mailto:kolsambathsambo@gmail.com" class="contact-email"
      >kolsambathsambo@gmail.com <ArrowUpRight size={22} /></a
    >
  </div>
  <div class="contact-groups">
    {
      contactGroups.map((group) => (
        <div class="contact-group" data-reveal>
          <>
            <h3 class="mono">
              <group.icon size={18} aria-hidden="true" />
              {group.title}
            </h3>
            <ul>
              {group.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target={link.download ? undefined : '_blank'}
                    rel={link.download ? undefined : 'noopener noreferrer'}
                    download={link.download || undefined}
                  >
                    <span>
                      {typeof link.icon === 'string' ? (
                        <img
                          src={link.icon}
                          alt=""
                          aria-hidden="true"
                          width="18"
                          height="18"
                        />
                      ) : (
                        <link.icon size={18} aria-hidden="true" />
                      )}
                      {link.label}
                    </span>
                    {link.download ? (
                      <Download size={16} />
                    ) : (
                      <ArrowUpRight size={17} />
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </>
        </div>
      ))
    }
  </div>
</section>
