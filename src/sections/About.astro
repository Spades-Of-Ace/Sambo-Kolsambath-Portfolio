---
import {
  ScanSearch,
  Focus,
  UsersRound,
  Target,
  CodeXml,
  MapPin,
  Cpu,
  Route,
} from '@lucide/astro';
// SECTION: About traits and profile details
const traits = [
  {
    icon: ScanSearch,
    title: 'Curious',
    text: 'Always exploring and learning.',
  },
  {
    icon: Focus,
    title: 'Focused',
    text: 'Driven by clarity and purpose.',
  },
  {
    icon: UsersRound,
    title: 'Collaborative',
    text: 'Better solutions together.',
  },
  {
    icon: Target,
    title: 'Impact Driven',
    text: 'Building for users and communities.',
  },
];

const infoItems = [
  {
    icon: CodeXml,
    title: 'Focus',
    lines: ['Frontend Development', 'UX / UI Design', 'Digital Solutions'],
  },
  {
    icon: MapPin,
    title: 'Based In',
    lines: ['Phnom Penh,', 'Cambodia'],
  },
  {
    icon: Cpu,
    title: 'Interests',
    lines: ['AI & Data', 'UX Research', 'Product Design'],
  },
  {
    icon: Route,
    title: 'Vision',
    lines: ['Using technology', 'to create solutions', 'that matter.'],
  },
];

// SECTION: Education entries
const education = [
  {
    number: '01',
    logo: '/logos/aupp-logo.png',
    school: 'American University of Phnom Penh',
    degree: 'Bachelor of Information Communication Technology',
    graduated: 'Graduated 2025',
  },
  {
    number: '02',
    logo: '/logos/ifl-logo.png',
    school: 'Institute of Foreign Languages',
    degree: 'Bachelor of English',
    graduated: 'Graduated 2026',
  },
];
---

<section
  id="about"
  data-nav-target="about"
  class="about-section section-pad"
  aria-labelledby="about-title"
>
  {/* SECTION: Bio and profile layout */}
  <div class="about-layout">
    <div data-reveal="left">
      <p class="small-label mono">THE PERSON BEHIND THE PIXELS</p><h2
        id="about-title"
        class="display-heading"
        data-heading-effect="blur"
      >
        DRIVEN BY<br /><em>CURIOSITY.</em>
      </h2><p class="about-lead">
        I'm Sambo Kolsambath.<br />You can call me <strong>Ace.</strong>
      </p><p class="section-description">
        A developer, designer, and problem solver who loves building meaningful
        digital experiences and turning ideas into real-world impact. My work
        brings together frontend development, UX/UI design, and business
        analysis.
      </p><div class="about-traits">
        {
          traits.map((trait) => (
            <div>
              <>
                <trait.icon size={24} aria-hidden="true" />
                <strong class="mono">{trait.title}</strong>
                <p>{trait.text}</p>
              </>
            </div>
          ))
        }
      </div>
    </div>
    <div class="about-detail" data-reveal="right">
      <figure class="about-photo">
        <img
          src="/assets/motorcycle/h2r/detail.webp"
          alt="Close-up of carbon fiber bodywork and a green motorcycle frame"
          loading="lazy"
          width="1200"
          height="675"
        /><figcaption class="mono">PRECISION IS A MINDSET.</figcaption>
      </figure><div class="about-info">
        {
          infoItems.map((item) => (
            <div>
              <>
                <p class="mono">
                  <item.icon size={17} aria-hidden="true" />
                  {item.title}
                </p>
                <p>{item.lines.join(' ')}</p>
              </>
            </div>
          ))
        }
      </div>
    </div>
  </div>
  {/* SECTION: Education layout */}
  <div class="education-heading mono">
    <span>THE FOUNDATION / EDUCATION</span><span
      >ALWAYS MOVING FORWARD <span class="lime">+</span></span
    >
  </div>
  <div class="education-grid">
    {
      education.map((item) => (
        <article class="education-item" data-reveal>
          <>
            <img
              src={item.logo}
              alt={`${item.school} logo`}
              width="64"
              height="64"
              loading="lazy"
            />
            <div>
              <>
                <span class="small-label mono">{item.graduated}</span>
                <h3>{item.school}</h3>
                <p>{item.degree}</p>
              </>
            </div>
            <span class="education-index mono">{item.number}</span>
          </>
        </article>
      ))
    }
  </div>
</section>
