---
import '../styles/hero.css';
import HeroActions from '../components/HeroActions.astro';
---

<section class="hero-section" aria-labelledby="home-hero-title">
  <div class="hero-inner">
    <div class="hero-content">
      <div class="intro animate-on-scroll">
        <div class="hero-sub">WELCOME TO THE EVENT HORIZON</div>
      </div>

      <h1 id="home-hero-title" class="hero-heading animate-on-scroll">
        <span class="line solid">I BUILD</span>
        <span class="line solid">DIGITAL</span>
        <span class="line outline">EXPERIENCES</span>
      </h1>

      <div class="hero-desc animate-on-scroll">
        <div class="decor" aria-hidden="true"></div>
        <p>
          Front-End Developer building structured, scalable, and user-focused
          digital experiences.
        </p>
      </div>

      <HeroActions />
    </div>

    <aside class="info-panel animate-on-scroll" aria-label="Profile summary">
      <span class="corner-tr" aria-hidden="true"></span>
      <span class="corner-bl" aria-hidden="true"></span>

      <div class="info-group">
        <div class="label">BASED IN</div>
        <div>Phnom Penh,<br />Cambodia</div>
      </div>

      <div class="info-group">
        <div class="label">CURRENT ROLE</div>
        <div>Front-End Developer</div>
        <div>UX/UI Designer</div>
      </div>

      <div class="info-group">
        <div class="label">FOCUS</div>
        <div>
          Frontend Development<br />
          UX/UI Design<br />
          Digital Systems
        </div>
      </div>
    </aside>
  </div>
</section>
