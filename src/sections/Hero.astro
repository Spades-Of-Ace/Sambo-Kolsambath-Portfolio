---
import HeroActions from '../components/HeroActions.astro';
import { ArrowUpRight } from '@lucide/astro';
---

<section
  id="home"
  data-nav-target="home"
  class="hero-section"
  aria-labelledby="home-hero-title"
>
  <div class="hero-stage">
    <div class="hero-topline mono">
      <span><i class="status-dot"></i> INDEPENDENT PORTFOLIO / 2026</span><span
        >PHNOM PENH, KH <ArrowUpRight size={13} /></span
      >
    </div>
    <div class="hero-copy">
      <p class="hero-eyebrow mono">DEVELOPER. DESIGNER. PROBLEM SOLVER.</p>
      <h1
        id="home-hero-title"
        data-heading-effect="split"
        data-ignition-heading
      >
        <span class="hero-name">SAMBO</span><span class="hero-surname"
          >KOLSAMBATH<span class="hero-name-dot">.</span></span
        >
      </h1>
      <p class="hero-motto">DESIGNED TO <em>PUSH LIMITS.</em></p>
      <p class="hero-description">
        Precision in design. Performance in code.<br />I turn complex
        requirements into clear, responsive digital experiences.
      </p>
      <HeroActions />
    </div>
    <div class="discipline-strip" aria-hidden="true">
      <span>PRECISION IN DESIGN</span><i>+</i><span>PERFORMANCE IN CODE</span><i
        >+</i
      ><span>CLARITY IN EVERY DETAIL</span><i>+</i><span>BUILT WITH INTENT</span
      ><i>+</i>
    </div>
  </div>
</section>
