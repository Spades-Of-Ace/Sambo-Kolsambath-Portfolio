---
const experiences = [
  {
    number: '01',
    logo: '/logos/mptc-logo.png',
    logoAlt: 'MPTC Logo',
    title: 'Junior Front-End Developer',
    org: 'Ministry of Post and Telecommunications',
    period: 'May 2025 - March 2026',
    year: '2025',
    description:
      'Contributed to the development and maintenance of national digital platforms, implementing responsive, component-based interfaces, integrating backend APIs, and maintaining structured frontend architecture across production systems.',
    tags: [
      'Frontend Development',
      'Responsive UI',
      'API Integration',
      'Government Systems',
    ],
  },
  {
    number: '02',
    logo: '/logos/mptc-logo.png',
    logoAlt: 'MPTC Logo',
    title: 'UX/UI Intern',
    org: 'Ministry of Post and Telecommunications',
    period: 'May 2024 - May 2025',
    year: '2024',
    description:
      'Contributed to UX/UI refinement and digital content development for government platforms, supporting interface consistency, bilingual content structure, accessibility, and alignment with government design standards.',
    tags: ['UX/UI', 'Design Systems', 'Digital Content', 'Government Platforms'],
  },
  {
    number: '03',
    logo: '/logos/csc-logo2.png',
    logoAlt: 'CSC Logo',
    title: 'Social Media & Website Officer',
    org: "Children's Surgical Centre (CSC)",
    period: 'May 2023 - December 2025',
    year: '2023',
    description:
      "Managed and structured content across CSC's website and social media channels, helping communicate the organization's mission, programs, and impact while maintaining consistent branding and accessible digital communication.",
    tags: [
      'Web Content',
      'Social Media',
      'Digital Communication',
      'Content Management',
    ],
  },
  {
    number: '04',
    logo: '/logos/kakvei-logo2.png',
    logoAlt: 'Kakvei Logo',
    title: 'Data Organizer',
    org: 'Kakvei',
    period: 'February 2023 - December 2025',
    year: '2023',
    description:
      'Organized and validated Khmer-language datasets for AI model training, focusing on linguistic accuracy, structural consistency, data integrity, and quality control for large-scale dataset development.',
    tags: ['AI Data', 'Khmer Language', 'Data Validation', 'Quality Control'],
  },
];
---

<section class="experience-page" aria-labelledby="experience-title">
  <div class="experience-shell">
    <div class="experience-copy">
      <h1 id="experience-title" class="experience-heading">
        <span>From Design</span>
        <span>To Digital</span>
        <span class="outline">Systems.</span>
      </h1>
      <div class="section-rule" aria-hidden="true"></div>
      <p class="experience-lede">
        A journey shaped by design, communication, data, and development,
        evolving toward building structured digital experiences and systems.
      </p>
    </div>

    <div class="timeline-wrap">
      <div class="timeline-arc" aria-hidden="true"></div>

      <ol class="experience-list" aria-label="Experience timeline">
        {
          experiences.map((item) => (
            <li class="experience-item">
              <div class="timeline-node" aria-hidden="true">
                <span>{item.number}</span>
              </div>

              <div class="experience-logo">
                <img src={item.logo} alt={item.logoAlt} loading="lazy" />
              </div>

              <article class="experience-card">
                <div class="experience-main">
                  <h2>{item.title}</h2>
                  <p class="org">{item.org}</p>
                  <p class="period">{item.period}</p>
                  <p class="description">{item.description}</p>
                  <p class="tags">{item.tags.join(' / ')}</p>
                </div>
                <div class="year-marker" aria-hidden="true">
                  <span></span>
                  <strong>{item.year}</strong>
                </div>
              </article>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
