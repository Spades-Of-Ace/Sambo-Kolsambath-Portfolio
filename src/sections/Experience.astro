---

<section
  id="experience"
  data-nav-target="experience"
  class="experience-section section-pad"
  aria-labelledby="experience-title"
>
  <div class="experience-layout">
    <header class="experience-intro" data-reveal="left">
      <h2 id="experience-title" class="display-heading">
        EVERY TURN.<br />A NEW <em>LEVEL.</em>
      </h2><p class="section-description">
        From communication and data to design and development. Every experience
        has shaped how I build.
      </p>
    </header>
    {/* SECTION: Timeline layout */}
    <ol class="experience-list">
      {
        experiences.map((item, index) => (
          <li
            class:list={['career-item', { current: index === 0 }]}
            data-reveal="right"
          >
            <span class="career-checkpoint mono">{item.number}</span>
            <div class="career-meta">
              <span class="mono">{item.period}</span>
              {index === 0 && (
                <span class="current-badge mono">
                  <i class="status-dot" />
                  CURRENT
                </span>
              )}
            </div>
            <div class="career-role">
              <>
                <div>
                  <>
                    <h3>{item.title}</h3>
                    <p class="career-org">{item.org}</p>
                  </>
                </div>
                <img
                  src={item.logo}
                  alt={item.logoAlt}
                  loading="lazy"
                  width="48"
                  height="48"
                />
              </>
            </div>
            <ul class="career-description">
              {item.highlights.map((highlight) => (
                <li>{highlight}</li>
              ))}
            </ul>
            <p class="career-tags mono">{item.tags.join(' / ')}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
