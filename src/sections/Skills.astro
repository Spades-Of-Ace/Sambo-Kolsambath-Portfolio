---
const skillGroups = [
  {
    number: '01',
    title: 'Core Stack',
    icon: '/svg%20icon/stack-fill.svg',
    skills: ['Astro', 'React', 'Tailwind CSS', 'Next.js', 'TypeScript'],
  },
  {
    number: '02',
    title: 'Supporting Stack',
    icon: '/svg%20icon/puzzle-piece-fill.svg',
    skills: ['HTML', 'CSS', 'JavaScript'],
  },
  {
    number: '03',
    title: 'Tools',
    icon: '/svg%20icon/wrench-fill.svg',
    skills: ['Git', 'GitHub', 'VS Code', 'Docker', 'Figma'],
  },
  {
    number: '04',
    title: 'Programming Background',
    icon: '/svg%20icon/atom-fill.svg',
    skills: ['Python', 'Java', 'C++'],
  },
];

const orbitNodes = [
  {
    className: 'node-frontend',
    icon: '/svg%20icon/atom-fill.svg',
    title: 'Frontend Development',
    description:
      'Astro, React, Tailwind CSS, Next.js, and TypeScript for structured interface development.',
  },
  {
    className: 'node-support',
    icon: '/svg%20icon/stack-fill.svg',
    title: 'Supporting Stack',
    description:
      'HTML, CSS, and JavaScript foundations for semantic, responsive, interactive web experiences.',
  },
  {
    className: 'node-tools',
    icon: '/svg%20icon/wrench-fill.svg',
    title: 'Tools',
    description:
      'Git, GitHub, VS Code, Docker, and Figma for building, testing, designing, and shipping.',
  },
  {
    className: 'node-programming',
    icon: '/svg%20icon/puzzle-piece-fill.svg',
    title: 'Programming Background',
    description:
      'Python, Java, and C++ experience that supports problem solving beyond the browser.',
  },
];
---

<section class="skills-page" aria-labelledby="skills-title">
  <div class="skills-grid-overlay" aria-hidden="true"></div>

  <div class="skills-hero">
    <div class="skills-copy">
      <h1 id="skills-title" class="skills-heading">
        <span>The System</span>
        <span>Behind</span>
        <span class="accent">The Work.</span>
      </h1>
      <div class="skills-rule" aria-hidden="true"></div>
      <p>
        A collection of technologies, tools, and knowledge that power the
        solutions I design and build.
      </p>
    </div>

    <div class="system-map" aria-label="Technology constellation system map">
      <div class="system-orbits" aria-hidden="true"></div>
      <div class="system-core">
        <span>Building</span>
        <span>Digital</span>
        <span>Solutions</span>
      </div>

      {
        orbitNodes.map((node) => (
          <button class:list={['orbit-node', node.className]} type="button">
            <span class="node-icon">
              <img src={node.icon} alt="" aria-hidden="true" />
            </span>
            <span class="node-label">{node.title}</span>
            <span class="node-detail">
              <strong>{node.title}</strong>
              <span>{node.description}</span>
            </span>
          </button>
        ))
      }
    </div>

    <aside class="learning-panel" aria-label="Learning note">
      <strong>
        <img src="/svg%20icon/sparkle-fill.svg" alt="" aria-hidden="true" />
        Always Learning
      </strong>
      <p>Technology evolves every day. So do I.</p>
    </aside>
  </div>

  <div class="skill-system-cards">
    {
      skillGroups.map((group) => (
        <article class="skill-system-card">
          <div class="skill-card-head">
            <div>
              <span>{group.number}</span>
              <h2>{group.title}</h2>
            </div>
            <i aria-hidden="true">
              <img src={group.icon} alt="" />
            </i>
          </div>

          <ul>
            {group.skills.map((skill) => (
              <li>
                <span>{skill}</span>
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</section>
