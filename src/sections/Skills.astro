---
import { CodeXml, Layers, Wrench, Terminal, ArrowUpRight } from '@lucide/astro';
// SECTION: Skill categories and their descriptions
const groups = [
  {
    title: 'Core frontend stack',
    label: 'Core Stack',
    icon: CodeXml,
    description:
      'Component-driven interfaces. Responsive by design. A stack chosen for clean architecture and thoughtful digital experiences.',
    skills: ['Astro', 'React', 'Tailwind CSS', 'Next.js', 'TypeScript'],
    note: 'STRUCTURE / COMPONENTS / INTERACTION',
  },
  {
    title: 'The fundamentals',
    label: 'Supporting Stack',
    icon: Layers,
    description:
      'Semantic HTML, carefully structured CSS, and JavaScript bring accessible, responsive interfaces to life across devices.',
    skills: ['HTML', 'CSS', 'JavaScript'],
    note: 'SEMANTICS / LAYOUT / BEHAVIOR',
  },
  {
    title: 'Tools of the trade',
    label: 'Tools',
    icon: Wrench,
    description:
      'From Figma components to version-controlled code, these tools connect design decisions with implementation and collaboration.',
    skills: ['Git', 'GitHub', 'VS Code', 'Docker', 'Figma'],
    note: 'DESIGN / COLLABORATE / SHIP',
  },
  {
    title: 'Beyond the browser',
    label: 'Programming Background',
    icon: Terminal,
    description:
      'A foundation in Python, Java, and C++ supports structured problem solving and an understanding of the systems behind an interface.',
    skills: ['Python', 'Java', 'C++'],
    note: 'LOGIC / SYSTEMS / PROBLEM SOLVING',
  },
];
---

<section
  id="skills"
  data-nav-target="skills"
  class="skills-section section-pad"
  aria-labelledby="skills-title"
>
  <div class="section-heading-row" data-reveal>
    <h2 id="skills-title" class="display-heading" data-heading-effect="float">
      THE SYSTEM<br />BEHIND THE <em>WORK.</em>
    </h2><p class="section-description">
      Good work starts with the right tools.<br />Great work comes from knowing
      how to use them.
    </p>
  </div>
  {/* SECTION: Skill tabs and detail panels */}
  <div class="skills-workbench" data-reveal>
    <div class="skill-tabs" aria-label="Skill categories">
      {
        groups.map((group, i) => (
          <button
            type="button"
            id={`skill-tab-${i}`}
            aria-controls={`skill-panel-${i}`}
            data-skill-tab={i}
          >
            <>
              <span class="mono">0{i + 1}</span>
              <group.icon size={20} />
              <span>{group.label}</span>
              <ArrowUpRight size={16} />
            </>
          </button>
        ))
      }
    </div>
    <div class="skill-panels">
      {
        groups.map((group, i) => (
          <div
            class="skill-panel"
            id={`skill-panel-${i}`}
            data-skill-panel={i}
            aria-labelledby={`skill-tab-${i}`}
          >
            <>
              <div class="skill-panel-top mono">
                <>
                  <span>MODULE / 0{i + 1}</span>
                  <span>
                    <i class="status-dot" /> ALWAYS LEARNING
                  </span>
                </>
              </div>
              <h3>{group.title}</h3>
              <p>{group.description}</p>
              <ul class="skill-items">
                {group.skills.map((skill, index) => (
                  <li>
                    <span class="mono">
                      {String(index + 1).padStart(2, '0')}
                    </span>
                    <strong>{skill}</strong>
                    <ArrowUpRight size={17} />
                  </li>
                ))}
              </ul>
              <div class="skill-panel-note mono">{group.note}</div>
            </>
          </div>
        ))
      }
    </div>
  </div>
</section>
<script>
  import {
    animateSkillPanel,
    resetSkillPanel,
  } from '../scripts/react-bits-motion';
  // SECTION: Selected tab, keyboard navigation, and panel animation
  const tabs = [
    ...document.querySelectorAll<HTMLButtonElement>('[data-skill-tab]'),
  ];
  const panels = [
    ...document.querySelectorAll<HTMLElement>('[data-skill-panel]'),
  ];
  document.querySelector('.skill-tabs')?.setAttribute('role', 'tablist');
  document
    .querySelector('.skill-tabs')
    ?.setAttribute('aria-orientation', 'vertical');
  let active = -1;
  const activate = (index: number, focus = false) => {
    const changed = active !== index;
    const initial = active === -1;
    if (changed) panels.forEach(resetSkillPanel);
    tabs.forEach((tab, i) => {
      tab.setAttribute('role', 'tab');
      tab.setAttribute('aria-selected', String(i === index));
      tab.tabIndex = i === index ? 0 : -1;
    });
    panels.forEach((panel, i) => {
      panel.setAttribute('role', 'tabpanel');
      panel.tabIndex = 0;
      panel.hidden = i !== index;
    });
    if (focus) tabs[index]?.focus();
    if (changed && !initial) animateSkillPanel(panels[index]);
    active = index;
  };
  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => activate(i));
    tab.addEventListener('keydown', (e) => {
      let index = i;
      if (e.key === 'ArrowDown' || e.key === 'ArrowRight')
        index = (i + 1) % tabs.length;
      else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft')
        index = (i + tabs.length - 1) % tabs.length;
      else if (e.key === 'Home') index = 0;
      else if (e.key === 'End') index = tabs.length - 1;
      else return;
      e.preventDefault();
      activate(index, true);
    });
  });
  activate(0);
  const motionPreference = matchMedia('(prefers-reduced-motion: reduce)');
  motionPreference.addEventListener('change', () => {
    if (motionPreference.matches) panels.forEach(resetSkillPanel);
  });
</script>
