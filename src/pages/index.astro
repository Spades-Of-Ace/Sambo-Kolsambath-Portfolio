---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Hero from '../sections/Hero.astro';
import Experience from '../sections/Experience.astro';
import Projects from '../sections/Projects.astro';
import Skills from '../sections/Skills.astro';
import About from '../sections/About.astro';
import Contact from '../sections/Contact.astro';
import RacingBackdrop from '../components/RacingBackdrop.astro';
import BikeDeparture from '../sections/BikeDeparture.astro';
import BootIntro from '../components/BootIntro.astro';
import '../styles/journey.css';
import '../styles/section-flow.css';
---

<BaseLayout title="Sambo Kolsambath / ACE RACING">
  <Navbar />
  <BootIntro />
  <RacingBackdrop />
  <div class="portfolio-journey">
    <Hero />
    <Experience />
    <Projects />
    <Skills />
    <About />
    <Contact />
    <BikeDeparture />
    <Footer />
  </div>
</BaseLayout>
