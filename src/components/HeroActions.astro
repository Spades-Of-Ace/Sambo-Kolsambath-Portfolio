---
const { resumeHref = '/cv/Resume.pdf', cvHref = '/cv/Curriculum Vitae.pdf' } = Astro.props;
---

<div class="hero-actions">
  <a href="/projects" class="glass-button primary">
    <span class="button-label">
      EXPLORE MY <span class="glow-word">WORK</span> ->
    </span>
  </a>
  <a
    href={resumeHref}
    class="hero-link"
    target="_blank"
    rel="noopener noreferrer">VIEW RESUME -></a
  >
  <a
    href={cvHref}
    class="hero-link"
    target="_blank"
    rel="noopener noreferrer">VIEW CV -></a
  >
</div>
