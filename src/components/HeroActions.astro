---
import { ArrowUpRight, Download } from '@lucide/astro';
const { resumeHref = '/cv/Resume.pdf', cvHref = '/cv/Curriculum Vitae.pdf' } =
  Astro.props;
---

<div class="hero-actions">
  <a href="#projects" class="button button-primary"
    >EXPLORE MY WORK <ArrowUpRight size={18} /></a
  >
  <a href={resumeHref} class="text-link" download
    >RESUME <Download size={15} /></a
  >
  <a href={cvHref} class="text-link" download>CV <Download size={15} /></a>
</div>
